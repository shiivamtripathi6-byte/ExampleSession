@model IEnumerable<ExampleSession.Models.Vendor.VendorComplain>

@{
    ViewBag.Title = "View_Complain";
    Layout = "~/Views/Shared/VendorZone.cshtml";
}

<link href="~/Content/akash.css" rel="stylesheet" />

<div class="row">
    <div class="col-1"></div>
    <div class="col-10">
        <h2 class="text-center text-danger text"> View User Complain</h2>
        <hr />
        <table class="table table-responsive" id="example">
            <thead class="table-striped">
                <tr style="background:orangered; color:white">
                    <th> Name</th>
                    <th>Message</th>
                    <th>status</th>
                    <th>cdate</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr>
                        <td>@i.Name</td>
                        <td>@i.Message</td>
                        <td>@i.status</td>
                        <td>@i.cdate</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<script src="~/Scripts/akash.js"></script>
<script>
    $(document).ready(function () {
        $("#example").DataTable();
    });
</script>
