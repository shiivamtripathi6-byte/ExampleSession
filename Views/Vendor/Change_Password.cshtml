@{
    ViewBag.Title = "Change_Password";
    Layout = "~/Views/Shared/VendorZone.cshtml";
}

<div class="row">
    <div class="col-4"></div>
    <div class="col-4">
        <h2>Change The Password</h2>
        <hr />
        <form action="/Vendor/Change_Password" method="post">
            enter old password
            <input type="password" class="form-control" name="txtoldpass" />
            enter new password
            <input type="password" class="form-control" name="txtnewpass" />
            enter confirm password
            <input type="password" class="form-control" name="txtconfirmpass" />
            <br />
            <input type="submit" class="form-control btn btn-success" value="Change Password" /> 
        </form>
    </div>
    <div class="col-4"></div>
</div>
