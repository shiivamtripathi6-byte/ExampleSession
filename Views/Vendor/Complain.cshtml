@model ExampleSession.Models.Vendor.VendorComplain
@{
    ViewBag.Title = "Complain";
    Layout = "~/Views/Shared/VendorZone.cshtml";
}

<div class="row">
    <div class="col-3"></div>
    <div class="col-5">
        <h1 class="text-primary text-center"  style="padding-top:12%;font-size:larger">Complain</h1>
        <hr style="height:3px; background-color:blue" /> 
        @using (Html.BeginForm("Complain", "Vendor", FormMethod.Post))
        {
            <div class="container-fluid" style="padding:0%">
                <div class="row">
                     @Html.LabelFor(model => model.Name)
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, "", new { style = "color:red" })

                    @Html.LabelFor(model => Model.Message)
                    @Html.TextBoxFor(model => model.Message, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Message, "", new { style = "color:red" })
                </div>
                <div class="row">
                    <br />
                    <input type="submit" class="form-control btn btn-outline-primary" value="Submit" />
                    <h3>@ViewBag.msg</h3> 
                </div>
            </div>
        }
    </div>
</div>
