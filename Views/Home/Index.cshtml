@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/GeneralZone.cshtml";
}
@using System.Data;
@using System.Data.SqlClient;
@using DemoApp25.Models;
<div class="container-fluid p-0">
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/content/images/yamunotri.jpg" class="d-block w-100" style="height:600px;object-fit:cover;" />
                <div class="carousel-caption">
                    <h1 class="fw-bold">Explore Uttarakhand</h1>
                    <p>Heaven on Earth</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/content/images/image2.jpg" class="d-block w-100" style="height:600px;object-fit:cover;" />
                <div class="carousel-caption">
                    <h1 class="fw-bold">Char Dham Yatra</h1>
                    <p>Divine Spiritual Journey</p>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</div>
<div class="container my-5">
    <h2 class="text-center fw-bold text-primary mb-4">Popular Destinations</h2>
    <div class="row g-4">
        @{
            string cmd = "select * from destination";
            DataTable dt = DatabaseManager.DispalyAllRecords(cmd);
            if (dt.Rows.Count > 0)
            {
                foreach (DataRow row in dt.Rows)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="card h-100 shadow-sm">
                            <img src="/Content/Upload/@row["dpic"]" class="card-img-top" style="height:200px;object-fit:cover;" />
                            <div class="card-body">
                                <h5 class="card-title">@row["dname"]</h5>
                                <p class="card-text small">@row["About"]</p>
                                <p class="mb-1"><strong>Duration:</strong> @row["dduration"]</p>
                                <p><strong>Price:</strong> ₹@row["dprice"]</p>
                            </div>
                            <div class="card-footer bg-white border-0">
                                <a href="#" class="btn btn-success w-100">Book Now</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <h4 class="text-danger text-center">No Destinations Found</h4>
            }
        }
    </div>
</div>
<div class="bg-light py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-4">Why Choose Us</h2>
        <div class="row text-center">
            <div class="col-md-3"><h1>⭐</h1><p>Best Packages</p></div>
            <div class="col-md-3"><h1>🛡️</h1><p>Safe Travel</p></div>
            <div class="col-md-3"><h1>⏰</h1><p>24/7 Support</p></div>
            <div class="col-md-3"><h1>😊</h1><p>Happy Customers</p></div>
        </div>
    </div>
</div>
<div class="container my-5 text-center">
    <h2 class="fw-bold">Plan Your Dream Trip Today</h2>
    <p>Affordable packages, trusted service & unforgettable experiences</p>
    <a href="/Packages" class="btn btn-primary btn-lg">View Packages</a>
</div>



