
@{
    ViewBag.Title = "AddUser";
    Layout = "~/Views/Shared/GeneralZone.cshtml";
}
@using System.Data;
@using System.Data.SqlClient;
@using DemoApp25.Models;
<h2>Add User</h2>
<div class="row">
    <div class="col-4"></div>
    <div class="col-4">
        Select Country
        <select id="ddlcountry" class="form-control">
            @{
                string cmd = "select * from country";
                DataTable dt = DatabaseManager.DispalyAllRecords(cmd);
                if(dt.Rows.Count>0)
                {
                    for(int i=0;i<dt.Rows.Count;i++)
                    {
                        <option value="@(dt.Rows[i]["cid"])">@(dt.Rows[i]["cname"])</option>
                    }
                }
                else
                {
                    <option>No Record Found</option>
                }
            }
        </select>

        Select State
        <select id="ddlstate" class="form-control">

        </select>

        Select District
        <select id="ddldistrict" class="form-control">

        </select>
    </div>
    <div class="col-4"></div>
</div>
<script>
    $(document).ready(function () {
        //alert("OK")
        $("#ddlcountry").change(function () {
            var ddl = $("#ddlcountry").val();//india
            $.ajax({
                type: "Post",
                url: "/Home/DDlState/",
                data: { Country: ddl },
                success:function(data)
                {
                    $("#ddlstate").empty();
                    $("#ddlstate").append(data);
                }
            })
        })
        //code for add district
        $("#ddlstate").change(function () {
            var ddl = $("#ddlstate").val();//india
            $.ajax({
                type: "Post",
                url: "/Home/DDlDistrict/",
                data: { State: ddl },
                success: function (data)
                {
                    $("#ddldistrict").empty();
                    $("#ddldistrict").append(data);
                }
            })
        })
    })
</script>
