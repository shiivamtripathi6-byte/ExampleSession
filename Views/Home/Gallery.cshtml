@{
    ViewBag.Title = "Gallery";
    Layout = "~/Views/Shared/GeneralZone.cshtml";
}
@using System.Data;
@using System.Data.SqlClient;
@using DemoApp25.Models;
<h2 class="text-center texxt-info">Gallery</h2>

<div class="container">
    <div class="row">
        <h3 class="text-center text-info">Let's find your Uttarakhand destiny</h3>
        <hr />
        @{
            string cmd = "select * from Destination";
            DataTable dt = DatabaseManager.DispalyAllRecords(cmd);
            if(dt.Rows.Count > 0)
            {
                for(int i =0; i < dt.Rows.Count; i++)
                {
                    <div class="col-3" style="padding:4%">
                        <img src="/Content/Upload/@dt.Rows[i]["dpic"]" style="height:200px;" class="img img-thumbnail" />
                        <h5>Destination Name:@dt.Rows[i]["dname"]</h5>
                        <span>Duration:@dt.Rows[i]["dduration"]</span>
                        <span>Price:@dt.Rows[i]["dprice"]Rs/-</span><br />
                        <span>Description:@dt.Rows[i]["about"]</span><br />
                        <a href="/Vendor/Add_places" class="btn btn-success form-control">Book Now</a> 
                    </div>
                }
            }
            else
            {
                <h3>No Destination Found here</h3>
            }
        }
    </div>
</div>
